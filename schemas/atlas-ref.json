{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "externalId": {
      "type": "string",
      "minLength": 1
    },
    "fragment": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "provider",
    "kind",
    "externalId"
  ],
  "additionalProperties": false
}
