{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unreadable-file",
              "unparseable",
              "schema-violation",
              "duplicate-id",
              "id-filename-mismatch",
              "malformed-reference",
              "unavailable-provider",
              "unresolved-reference",
              "wrong-kind",
              "unknown-fragment",
              "asymmetric-link"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "column": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "code",
          "severity",
          "message",
          "file"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "errors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "warnings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "errors",
        "warnings"
      ],
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "kind": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "externalId": {
                "type": "string",
                "minLength": 1
              },
              "fragment": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "provider",
              "kind",
              "externalId"
            ],
            "additionalProperties": false
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "sourcePath": {
                "type": "string",
                "minLength": 1
              },
              "sourceUrl": {
                "type": "string",
                "minLength": 1
              },
              "sourceVersion": {
                "type": "string",
                "minLength": 1
              },
              "contentHash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "query": {
                "type": "string",
                "minLength": 1
              },
              "sourceLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "retrievedAt": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "attributes": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "ref",
          "title",
          "provenance",
          "attributes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "problems",
    "summary",
    "records"
  ],
  "additionalProperties": false
}
