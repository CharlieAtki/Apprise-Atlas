{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "unreadable-file",
        "unparseable",
        "schema-violation",
        "duplicate-id",
        "id-filename-mismatch",
        "malformed-reference",
        "unavailable-provider",
        "unresolved-reference",
        "wrong-kind",
        "unknown-fragment",
        "asymmetric-link"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warning"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "file": {
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "column": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "code",
    "severity",
    "message",
    "file"
  ],
  "additionalProperties": false
}
