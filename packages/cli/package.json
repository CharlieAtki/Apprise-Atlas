{
  "name": "@apprise/atlas-cli",
  "version": "0.0.0",
  "description": "Command-line delivery for Apprise Atlas.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.3"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "atlas": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@apprise/atlas-core": "workspace:*",
    "@apprise/atlas-provider-likec4": "workspace:*",
    "@apprise/atlas-provider-markdown": "workspace:*",
    "@apprise/atlas-toolkit": "workspace:*"
  }
}
